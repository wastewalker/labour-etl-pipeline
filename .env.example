# Copy to .env for local runs. Never commit the real file.

# Matches the service in docker-compose.yml.
DATABASE_URL=postgres://labour:labour@localhost:5432/labour_etl

LOG_LEVEL=INFO

# Per-request timeout and retry budget for the HTTP sources.
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3

# Restrict the load to these ISO-3166 alpha-3 codes. Empty means every country
# the source publishes.
COUNTRY_FILTER=BOL,PER,CHL,ARG,BRA,COL,ECU,PRY,URY,MEX

# Ignore observations before this year. The sources reach back to 1991, and a
# portfolio database does not need three decades to prove the point.
MIN_YEAR=2010
